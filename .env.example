# ---------- Core ----------
NODE_ENV=development
PLATFORM_NAME=MyTrakin

# ---------- Frontend (apps/web) ----------
# NEXT_PUBLIC_* values are embedded in the browser bundle. Never place a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=MyTrakin
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ---------- API (apps/api) ----------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- Supabase / Database ----------
# anon key: safe to expose to the browser (RLS enforced)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role: SERVER ONLY. Grants full access bypassing RLS. Used exclusively by
# storage signing, auth admin operations, and background workers.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# read-only replica / analytics connection pool
DATABASE_READ_REPLICA_URL=

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Auth policy ----------
REQUIRE_EMAIL_VERIFICATION=true
SESSION_MAX_AGE_SECONDS=2592000
ALLOW_GOOGLE_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Storage ----------
STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_UPLOADS=uploads
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400
# Malware scanner (ClamAV INSTREAM over TCP). Empty = unconfigured: uploads
# stay scan-PENDING and are never marked clean without a real scan.
MALWARE_SCANNER_URL=

# ---------- Email ----------
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=no-reply@mytrakin.app
EMAIL_FROM_NAME=MyTrakin
RESEND_API_KEY=

# ---------- AI Gateway ----------
# No vendor is hard-coded in application code. Enable providers by supplying keys.
AI_GATEWAY_ENABLED=true
AI_DEFAULT_CHAT_PROVIDER=openai
AI_DEFAULT_EMBEDDING_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-pro
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
AI_MAX_CONTEXT_CHARS=120000
AI_CITATIONS_REQUIRED=true
AI_PII_REDACTION=true

# ---------- AI budget ----------
AI_DAILY_TOKEN_BUDGET_PER_USER=200000
AI_DAILY_COST_BUDGET_PER_COMPANY_CENTS=5000

# ---------- Plaid (bank connections only; NOT a payment processor) ----------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
PLAID_TOKEN_ENCRYPTION_KEY=

# ---------- Payment processor (money movement) ----------
PAYMENT_PROCESSOR=stripe
PAYMENT_PROCESSOR_API_KEY=
PAYMENT_PROCESSOR_WEBHOOK_SECRET=

# ---------- Observability ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
